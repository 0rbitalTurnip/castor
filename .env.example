# Run ./scripts/setup-web.sh instead of typing secrets by hand.
# Pin this to an image digest after compatibility testing; latest can change.
CASTOR_IMAGE=ghcr.io/stupside/castor:latest
CASTOR_API__TOKEN=
CASTOR_SERVER__TOKEN=
CASTOR_SCRAPING__TOKEN=
CASTOR_WEB_USERNAME=castor
CASTOR_WEB_PASSWORD=
# Safe default: use an SSH tunnel or HTTPS reverse proxy.
# To use a trusted LAN directly, explicitly change to 0.0.0.0 (HTTP is not encrypted).
CASTOR_WEB_BIND=127.0.0.1
CASTOR_WEB_PORT=3000
# Set the media server's LAN IPv4 address before starting.
CASTOR_SERVER__ADVERTISE=http://192.168.1.10:8410
